<?xml version="1.0" encoding="UTF-8"?>
<!-- Created with JasperReports 6.21. Can be opened and edited visually in
     Jaspersoft Studio (free plugin for Eclipse-based IDEs) to adjust layout,
     fonts, hospital logo, etc.

     "Blocks" layout: the report is organized in one block per employee
     category (categoryGroup), and inside each block, one sub-section per
     employee who used the cafeteria in that category (employeeGroup),
     listing their meals (type, time, date, price). Each category block ends
     with its own total (quantity + a per-type breakdown). This requires the
     data fed into the report to already be sorted by category, then by
     employee, then by date/time — see the sort in
     MealService.generatePeriodReport, right before it calls
     ReportGenerator.generatePdf with this template.

     A grand total for the whole period (all categories combined) is still
     shown at the very end (summary band), same as before — besides the
     total price, it shows the quantity of meals broken down by type
     ("typeBreakdown" parameter) and by employee category ("categoryBreakdown"
     parameter), both computed in MealService.generatePeriodReport. The title
     band shows any category/type/employee filters applied (see the
     "filters" parameter) besides the date range, which always applies. -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="refeitorio_report" pageWidth="595" pageHeight="842"
              columnWidth="595" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="20">

    <property name="com.jaspersoft.studio.data.defaultdataadapter" value="One Empty Record"/>

    <!-- Zebra: applied to every cell in the detail band (they all share the
         same REPORT_COUNT on the same row, so the effect is a whole striped
         row). Must come BEFORE parameter/field: that's the ordering required
         by JasperReports' XSD (the same kind of ordering issue we already
         fixed before between pageFooter/summary). -->
    <style name="zebraRow" mode="Opaque" backcolor="#FFFFFF">
        <conditionalStyle>
            <conditionExpression><![CDATA[$V{REPORT_COUNT}.intValue() % 2 == 0]]></conditionExpression>
            <style backcolor="#F6F8F5"/>
        </conditionalStyle>
    </style>

    <parameter name="startDate" class="java.lang.String"/>
    <parameter name="endDate" class="java.lang.String"/>
    <parameter name="total" class="java.math.BigDecimal"/>
    <parameter name="quantity" class="java.lang.Integer"/>
    <parameter name="typeBreakdown" class="java.lang.String"/>
    <parameter name="categoryBreakdown" class="java.lang.String"/>
    <parameter name="filters" class="java.lang.String"/>

    <field name="id" class="java.lang.Integer"/>
    <field name="employeeId" class="java.lang.Integer"/>
    <field name="employeeName" class="java.lang.String"/>
    <field name="employeeCategory" class="java.lang.String"/>
    <field name="date" class="java.time.LocalDate"/>
    <field name="time" class="java.time.LocalTime"/>
    <field name="price" class="java.math.BigDecimal"/>
    <field name="type" class="com.hospital.harmonia.model.MealType"/>

    <!-- Per-category counters (reset every time categoryGroup breaks). One
         "Count" variable per meal type, each only counting rows of that
         type (null otherwise, which Count ignores) — the closest thing to
         a per-type tally that plain JasperReports variables can do without
         a subreport or scriptlet. -->
    <variable name="categoryTotal" class="java.lang.Integer" resetType="Group" resetGroup="categoryGroup" calculation="Count">
        <variableExpression><![CDATA[Integer.valueOf(1)]]></variableExpression>
    </variable>
    <variable name="categoryQtyDejejum" class="java.lang.Integer" resetType="Group" resetGroup="categoryGroup" calculation="Count">
        <variableExpression><![CDATA[$F{type} == com.hospital.harmonia.model.MealType.CAFE_DA_MANHA ? Integer.valueOf(1) : null]]></variableExpression>
    </variable>
    <variable name="categoryQtyAlmoco" class="java.lang.Integer" resetType="Group" resetGroup="categoryGroup" calculation="Count">
        <variableExpression><![CDATA[$F{type} == com.hospital.harmonia.model.MealType.ALMOCO ? Integer.valueOf(1) : null]]></variableExpression>
    </variable>
    <variable name="categoryQtyJantar" class="java.lang.Integer" resetType="Group" resetGroup="categoryGroup" calculation="Count">
        <variableExpression><![CDATA[$F{type} == com.hospital.harmonia.model.MealType.JANTAR ? Integer.valueOf(1) : null]]></variableExpression>
    </variable>
    <variable name="categoryQtyCeia" class="java.lang.Integer" resetType="Group" resetGroup="categoryGroup" calculation="Count">
        <variableExpression><![CDATA[$F{type} == com.hospital.harmonia.model.MealType.CEIA ? Integer.valueOf(1) : null]]></variableExpression>
    </variable>
    <variable name="categoryQtyLanche" class="java.lang.Integer" resetType="Group" resetGroup="categoryGroup" calculation="Count">
        <variableExpression><![CDATA[$F{type} == com.hospital.harmonia.model.MealType.LANCHE ? Integer.valueOf(1) : null]]></variableExpression>
    </variable>

    <!-- Per-employee subtotal (reset every time employeeGroup breaks). -->
    <variable name="employeeMealCount" class="java.lang.Integer" resetType="Group" resetGroup="employeeGroup" calculation="Count">
        <variableExpression><![CDATA[Integer.valueOf(1)]]></variableExpression>
    </variable>

    <!-- Outer group: one block per employee category. The expression below is
         the SAME key MealService.categoryGroupKey() sorts by (blank/null goes
         to "Sem categoria", then uppercase) and the two must stay in sync:
         category is free text typed by hand, so "Alunos" and "ALUNOS" are the
         same group of people and belong in one block. Grouping by the raw
         value while the data was sorted case-insensitively produced two
         blocks with the same title and split totals, contradicting the
         combined figure in the summary band at the end. -->
    <group name="categoryGroup" isReprintHeaderOnEachPage="true">
        <groupExpression><![CDATA[(($F{employeeCategory} == null || $F{employeeCategory}.trim().length() == 0) ? "Sem categoria" : $F{employeeCategory}).toUpperCase()]]></groupExpression>
        <groupHeader>
            <band height="34">
                <rectangle>
                    <reportElement x="30" y="8" width="535" height="22" backcolor="#4C7A1F" mode="Opaque"/>
                    <graphicElement>
                        <pen lineWidth="0.0"/>
                    </graphicElement>
                </rectangle>
                <textField>
                    <reportElement x="40" y="8" width="515" height="22" forecolor="#FFFFFF"/>
                    <textElement verticalAlignment="Middle">
                        <font size="11" isBold="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA["CATEGORIA: " + (($F{employeeCategory} == null || $F{employeeCategory}.trim().length() == 0) ? "Sem categoria" : $F{employeeCategory}).toUpperCase()]]></textFieldExpression>
                </textField>
            </band>
        </groupHeader>
        <groupFooter>
            <band height="46">
                <rectangle>
                    <reportElement x="30" y="2" width="535" height="36" backcolor="#EAF2E2" mode="Opaque"/>
                    <graphicElement>
                        <pen lineWidth="0.75" lineColor="#B9D19B"/>
                    </graphicElement>
                </rectangle>
                <textField>
                    <reportElement x="40" y="6" width="400" height="14" forecolor="#2F5C0E"/>
                    <textElement verticalAlignment="Middle">
                        <font size="9" isBold="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA["Total da categoria: " + $V{categoryTotal} + " refeição(ões)"]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement x="40" y="20" width="515" height="14" forecolor="#33422F"/>
                    <textElement verticalAlignment="Middle">
                        <font size="8"/>
                    </textElement>
                    <textFieldExpression><![CDATA["Dejejum: " + $V{categoryQtyDejejum} + "   Almoço: " + $V{categoryQtyAlmoco} + "   Jantar: " + $V{categoryQtyJantar} + "   Ceia: " + $V{categoryQtyCeia} + "   Lanche: " + $V{categoryQtyLanche}]]></textFieldExpression>
                </textField>
            </band>
        </groupFooter>
    </group>

    <!-- Inner group (nested inside categoryGroup, by declaration order): one
         sub-section per employee, listing their meals below their name.
         Grouped by employeeId, NOT by employeeName: the database enforces a
         unique matrícula but not a unique name, so two different people can
         both be "Maria Silva" — grouping by name merged their meals into one
         block under one total. The header still displays the name; two
         same-named employees now produce two separate blocks, each with its
         own subtotal. -->
    <group name="employeeGroup" isReprintHeaderOnEachPage="true">
        <groupExpression><![CDATA[$F{employeeId}]]></groupExpression>
        <groupHeader>
            <band height="20">
                <textField>
                    <reportElement x="45" y="2" width="400" height="16" forecolor="#33422F"/>
                    <textElement verticalAlignment="Middle">
                        <font size="10" isBold="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA[$F{employeeName}]]></textFieldExpression>
                </textField>
                <line>
                    <reportElement x="45" y="18" width="120" height="1"/>
                    <graphicElement>
                        <pen lineColor="#C9D4C0"/>
                    </graphicElement>
                </line>
            </band>
        </groupHeader>
        <groupFooter>
            <band height="16">
                <textField>
                    <reportElement x="70" y="0" width="300" height="14" forecolor="#6B7566"/>
                    <textElement verticalAlignment="Middle">
                        <font size="8" isItalic="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA[$V{employeeMealCount} + " refeição(ões)"]]></textFieldExpression>
                </textField>
            </band>
        </groupFooter>
    </group>

    <title>
        <band height="86">
            <rectangle>
                <reportElement x="0" y="0" width="595" height="86" backcolor="#4C7A1F" mode="Opaque"/>
                <graphicElement>
                    <pen lineWidth="0.0"/>
                </graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="30" y="18" width="400" height="28" forecolor="#FFFFFF"/>
                <textElement>
                    <font size="20" isBold="true"/>
                </textElement>
                <text><![CDATA[Relatório de Refeições]]></text>
            </staticText>
            <staticText>
                <reportElement x="30" y="46" width="400" height="16" forecolor="#DCEAC9"/>
                <textElement>
                    <font size="10"/>
                </textElement>
                <text><![CDATA[Refeitório · Harmonia]]></text>
            </staticText>
            <textField>
                <reportElement x="330" y="18" width="235" height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right">
                    <font size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Período: " + $P{startDate} + " a " + $P{endDate}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="330" y="36" width="235" height="16" forecolor="#DCEAC9"/>
                <textElement textAlignment="Right">
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{quantity} + " refeição(ões) registrada(s)"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="230" y="54" width="335" height="14" forecolor="#DCEAC9"/>
                <textElement textAlignment="Right">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[($P{filters} == null || $P{filters}.isEmpty()) ? "" : ("Filtros: " + $P{filters})]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="20">
            <rectangle>
                <reportElement x="30" y="0" width="535" height="18" backcolor="#EFF3EB" mode="Opaque"/>
                <graphicElement>
                    <pen lineWidth="0.0"/>
                </graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="70" y="0" width="120" height="18" forecolor="#33422F"/>
                <textElement verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[TIPO]]></text>
            </staticText>
            <staticText>
                <reportElement x="200" y="0" width="80" height="18" forecolor="#33422F"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[HORÁRIO]]></text>
            </staticText>
            <staticText>
                <reportElement x="290" y="0" width="100" height="18" forecolor="#33422F"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[DATA]]></text>
            </staticText>
            <staticText>
                <reportElement x="460" y="0" width="105" height="18" forecolor="#33422F"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[PREÇO (R$)]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="18">
            <textField>
                <reportElement x="70" y="0" width="120" height="18" style="zebraRow"/>
                <textElement verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{type}.getDescription()]]></textFieldExpression>
            </textField>
            <textField pattern="HH:mm">
                <reportElement x="200" y="0" width="80" height="18" style="zebraRow"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[java.sql.Time.valueOf($F{time})]]></textFieldExpression>
            </textField>
            <textField pattern="dd/MM/yyyy">
                <reportElement x="290" y="0" width="100" height="18" style="zebraRow"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[java.sql.Date.valueOf($F{date})]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="460" y="0" width="105" height="18" style="zebraRow"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{price}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="24">
            <line>
                <reportElement x="30" y="0" width="535" height="1"/>
                <graphicElement>
                    <pen lineColor="#E4E7E1"/>
                </graphicElement>
            </line>
            <textField>
                <reportElement x="30" y="6" width="300" height="14" forecolor="#8A9086"/>
                <textElement>
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Gerado em " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="365" y="6" width="200" height="14" forecolor="#8A9086"/>
                <textElement textAlignment="Right">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="88">
            <rectangle>
                <reportElement x="330" y="4" width="235" height="32" backcolor="#EAF2E2" mode="Opaque"/>
                <graphicElement>
                    <pen lineWidth="0.75" lineColor="#B9D19B"/>
                </graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="345" y="10" width="120" height="20" forecolor="#33422F"/>
                <textElement verticalAlignment="Middle">
                    <font size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[Total do período]]></text>
            </staticText>
            <textField>
                <reportElement x="410" y="10" width="140" height="20" forecolor="#2F5C0E"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="13" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["R$ " + new java.text.DecimalFormat("#,##0.00").format($P{total})]]></textFieldExpression>
            </textField>
            <rectangle>
                <reportElement x="30" y="44" width="535" height="20" backcolor="#EFF3EB" mode="Opaque"/>
                <graphicElement>
                    <pen lineWidth="0.0"/>
                </graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="40" y="44" width="190" height="20" forecolor="#33422F"/>
                <textElement verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Quantidade por tipo de refeição:]]></text>
            </staticText>
            <textField>
                <reportElement x="230" y="44" width="325" height="20" forecolor="#33422F"/>
                <textElement verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{typeBreakdown}]]></textFieldExpression>
            </textField>
            <rectangle>
                <reportElement x="30" y="66" width="535" height="20" backcolor="#EFF3EB" mode="Opaque"/>
                <graphicElement>
                    <pen lineWidth="0.0"/>
                </graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="40" y="66" width="190" height="20" forecolor="#33422F"/>
                <textElement verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Quantidade por categoria:]]></text>
            </staticText>
            <textField>
                <reportElement x="230" y="66" width="325" height="20" forecolor="#33422F"/>
                <textElement verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{categoryBreakdown}]]></textFieldExpression>
            </textField>
        </band>
    </summary>

</jasperReport>
