<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.hospital</groupId>
    <artifactId>harmonia</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Harmonia</name>
    <description>Sistema modular: Refeitorio, Descarte de Ativos e Assistencia Tecnica</description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <javafx.version>21.0.2</javafx.version>
        <postgres.version>42.7.3</postgres.version>
        <jasper.version>6.21.3</jasper.version>

        <!-- Main class (launcher). See util/Launcher.java -->
        <mainClass>com.hospital.harmonia.Launcher</mainClass>
    </properties>

    <dependencies>

        <!-- ============ JavaFX ============ -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- ============ ControlsFX (extra JavaFX controls; used by the
             CheckComboBox in the Category/Type filters on the Cafeteria
             report, which allow selecting several values at once) ============ -->
        <dependency>
            <groupId>org.controlsfx</groupId>
            <artifactId>controlsfx</artifactId>
            <version>11.2.1</version>
        </dependency>

        <!-- ============ PostgreSQL JDBC Driver ============ -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgres.version}</version>
        </dependency>

        <!-- ============ Connection pool (recommended for production) ============ -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>5.1.0</version>
        </dependency>

        <!-- ============ JasperReports ============ -->
        <dependency>
            <groupId>net.sf.jasperreports</groupId>
            <artifactId>jasperreports</artifactId>
            <version>${jasper.version}</version>
        </dependency>
        <dependency>
            <groupId>net.sf.jasperreports</groupId>
            <artifactId>jasperreports-fonts</artifactId>
            <version>${jasper.version}</version>
        </dependency>

        <!-- ============ Excel spreadsheet generation (.xlsx report) ============ -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.2.5</version>
        </dependency>

        <!-- ============ Password hashing (BCrypt) ============ -->
        <dependency>
            <groupId>org.mindrot</groupId>
            <artifactId>jbcrypt</artifactId>
            <version>0.4</version>
        </dependency>

        <!-- ============ Logging ============ -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.13</version>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>1.5.6</version>
        </dependency>

        <!-- ============ Testes ============ -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <finalName>harmonia</finalName>
        <plugins>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>17</release>
                </configuration>
            </plugin>

            <!-- Plugin to run the JavaFX app directly through Maven: mvn javafx:run -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>com.hospital.harmonia.App</mainClass>
                    <launcher>harmonia</launcher>
                </configuration>
            </plugin>

            <!-- Builds a "fat jar" with all dependencies, to distribute the finished program -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.3</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${mainClass}</mainClass>
                                </transformer>
                                <!-- Needed for Apache POI (.xlsx report): several libraries inside
                                     it register services in the same META-INF/services file, and
                                     without this the maven-shade-plugin keeps only the last one,
                                     breaking things at runtime. This transformer does the correct
                                     merge. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

    <!-- =====================================================================
         PROFILE: package-msi
         Builds a real Windows installer (.msi) from the fat jar, ready to be
         pushed by the GPO Software Installation policy discussed with
         Giovani (2026-09-18); this profile doesn't run on a normal
         "mvn package"; it's a separate, explicit step:

             mvn package -Ppackage-msi

         Prerequisites on whichever machine builds the installer:
           - JDK 17+ (jpackage ships inside the JDK itself, nothing extra to
             install for that part).
           - WiX Toolset v3 (https://wixtoolset.org/): jpackage's Windows
             "msi" type shells out to WiX (candle.exe/light.exe) to actually
             build the .msi. Without it, this profile fails with an error
             naming "WiX Tools".

         IMPORTANT for GPO upgrades to work: <winUpgradeUuid> below must
         NEVER change between releases; it's what tells Windows Installer
         (and therefore the GPO Software Installation "Upgrades" tab) that a
         new .msi is a newer version of the SAME product, instead of an
         unrelated program. Only <version> above (top of this file) should
         change from one release to the next; bump it before each
         package-msi build (e.g. 1.0.0 -> 1.1.0).
         ===================================================================== -->
    <profiles>
        <profile>
            <id>package-msi</id>
            <properties>
                <!-- Placeholder: replace with the hospital/department name
                     that should show up in "Add or Remove Programs". -->
                <jpackage.vendor>Hospital</jpackage.vendor>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <version>1.6.0</version>
                        <executions>
                            <execution>
                                <phase>package</phase>
                                <goals>
                                    <goal>jpackage</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <name>Harmonia</name>
                            <appVersion>${project.version}</appVersion>
                            <vendor>${jpackage.vendor}</vendor>
                            <destination>target/dist</destination>
                            <input>target</input>
                            <mainJar>${project.build.finalName}.jar</mainJar>
                            <mainClass>${mainClass}</mainClass>
                            <!-- Optional: point this at a .ico version of
                                 src/main/resources/images/app-icon.png once one
                                 exists (jpackage on Windows needs .ico, not
                                 .png); safe to leave commented out for now,
                                 jpackage just falls back to a default icon. -->
                            <!-- <icon>src/main/resources/images/app-icon.ico</icon> -->
                            <type>MSI</type>
                            <winMenu>true</winMenu>
                            <winShortcut>true</winShortcut>
                            <winDirChooser>false</winDirChooser>
                            <!-- Fixed on purpose, see the note above. Generated
                                 once with `python3 -c "import uuid; print(uuid.uuid4())"`
                                 on 2026-09-18; never regenerate this. -->
                            <winUpgradeUuid>6F6BA38F-3F89-4AD7-A5EE-65F833EFF07B</winUpgradeUuid>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
