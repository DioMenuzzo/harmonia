<?xml version="1.0" encoding="UTF-8"?>
<!-- Created with JasperReports 6.21. Can be opened and edited visually in
     Jaspersoft Studio (free plugin for Eclipse-based IDEs) to adjust layout,
     fonts, hospital logo, etc.

     "Modern" layout: colored title band (same green as the system's
     buttons), light column header, zebra-striped rows and a highlighted
     total in the footer. Shows 6 columns: Employee, Category, Type, Time,
     Date and Price; id is still available as a field (data) but isn't
     printed. The summary band also shows, besides the period's total price,
     the quantity of meals broken down by type ("typeBreakdown" parameter)
     and by employee category ("categoryBreakdown" parameter), both
     computed in MealService.generatePeriodReport. The title band shows any
     category/type/employee filters applied (see the "filters" parameter)
     besides the date range, which always applies. -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="refeitorio_report" pageWidth="595" pageHeight="842"
              columnWidth="595" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="20">

    <property name="com.jaspersoft.studio.data.defaultdataadapter" value="One Empty Record"/>

    <!-- Zebra: applied to every cell in the detail band (they all share the
         same REPORT_COUNT on the same row, so the effect is a whole striped
         row). Must come BEFORE parameter/field: that's the ordering required
         by JasperReports' XSD (the same kind of ordering issue we already
         fixed before between pageFooter/summary). -->
    <style name="zebraRow" mode="Opaque" backcolor="#FFFFFF">
        <conditionalStyle>
            <conditionExpression><![CDATA[$V{REPORT_COUNT}.intValue() % 2 == 0]]></conditionExpression>
            <style backcolor="#F6F8F5"/>
        </conditionalStyle>
    </style>

    <parameter name="startDate" class="java.lang.String"/>
    <parameter name="endDate" class="java.lang.String"/>
    <parameter name="total" class="java.math.BigDecimal"/>
    <parameter name="quantity" class="java.lang.Integer"/>
    <parameter name="typeBreakdown" class="java.lang.String"/>
    <parameter name="categoryBreakdown" class="java.lang.String"/>
    <parameter name="filters" class="java.lang.String"/>

    <field name="id" class="java.lang.Integer"/>
    <field name="employeeName" class="java.lang.String"/>
    <field name="employeeCategory" class="java.lang.String"/>
    <field name="date" class="java.time.LocalDate"/>
    <field name="time" class="java.time.LocalTime"/>
    <field name="price" class="java.math.BigDecimal"/>
    <field name="type" class="com.hospital.harmonia.model.MealType"/>

    <title>
        <band height="86">
            <rectangle>
                <reportElement x="0" y="0" width="595" height="86" backcolor="#4C7A1F" mode="Opaque"/>
                <graphicElement>
                    <pen lineWidth="0.0"/>
                </graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="30" y="18" width="400" height="28" forecolor="#FFFFFF"/>
                <textElement>
                    <font size="20" isBold="true"/>
                </textElement>
                <text><![CDATA[Relatório de Refeições]]></text>
            </staticText>
            <staticText>
                <reportElement x="30" y="46" width="400" height="16" forecolor="#DCEAC9"/>
                <textElement>
                    <font size="10"/>
                </textElement>
                <text><![CDATA[Refeitório · Harmonia]]></text>
            </staticText>
            <textField>
                <reportElement x="330" y="18" width="235" height="16" forecolor="#FFFFFF"/>
                <textElement textAlignment="Right">
                    <font size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Período: " + $P{startDate} + " a " + $P{endDate}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="330" y="36" width="235" height="16" forecolor="#DCEAC9"/>
                <textElement textAlignment="Right">
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{quantity} + " refeição(ões) registrada(s)"]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="230" y="54" width="335" height="14" forecolor="#DCEAC9"/>
                <textElement textAlignment="Right">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[($P{filters} == null || $P{filters}.isEmpty()) ? "" : ("Filtros: " + $P{filters})]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="26">
            <rectangle>
                <reportElement x="30" y="4" width="535" height="20" backcolor="#EFF3EB" mode="Opaque"/>
                <graphicElement>
                    <pen lineWidth="0.0"/>
                </graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="30" y="4" width="120" height="20" forecolor="#33422F"/>
                <textElement verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[COLABORADOR]]></text>
            </staticText>
            <staticText>
                <reportElement x="150" y="4" width="90" height="20" forecolor="#33422F"/>
                <textElement verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[CATEGORIA]]></text>
            </staticText>
            <staticText>
                <reportElement x="240" y="4" width="80" height="20" forecolor="#33422F"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[TIPO]]></text>
            </staticText>
            <staticText>
                <reportElement x="320" y="4" width="60" height="20" forecolor="#33422F"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[HORÁRIO]]></text>
            </staticText>
            <staticText>
                <reportElement x="380" y="4" width="80" height="20" forecolor="#33422F"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[DATA]]></text>
            </staticText>
            <staticText>
                <reportElement x="460" y="4" width="105" height="20" forecolor="#33422F"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[PREÇO (R$)]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="24">
            <textField>
                <reportElement x="30" y="0" width="120" height="24" style="zebraRow"/>
                <textElement verticalAlignment="Middle">
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{employeeName}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="150" y="0" width="90" height="24" style="zebraRow"/>
                <textElement verticalAlignment="Middle">
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{employeeCategory}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="240" y="0" width="80" height="24" style="zebraRow"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{type}.getDescription()]]></textFieldExpression>
            </textField>
            <textField pattern="HH:mm">
                <reportElement x="320" y="0" width="60" height="24" style="zebraRow"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[java.sql.Time.valueOf($F{time})]]></textFieldExpression>
            </textField>
            <textField pattern="dd/MM/yyyy">
                <reportElement x="380" y="0" width="80" height="24" style="zebraRow"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[java.sql.Date.valueOf($F{date})]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="460" y="0" width="105" height="24" style="zebraRow"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{price}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="30" y="23" width="535" height="1"/>
                <graphicElement>
                    <pen lineColor="#E4E7E1"/>
                </graphicElement>
            </line>
        </band>
    </detail>

    <pageFooter>
        <band height="24">
            <line>
                <reportElement x="30" y="0" width="535" height="1"/>
                <graphicElement>
                    <pen lineColor="#E4E7E1"/>
                </graphicElement>
            </line>
            <textField>
                <reportElement x="30" y="6" width="300" height="14" forecolor="#8A9086"/>
                <textElement>
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Gerado em " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="365" y="6" width="200" height="14" forecolor="#8A9086"/>
                <textElement textAlignment="Right">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="88">
            <rectangle>
                <reportElement x="330" y="4" width="235" height="32" backcolor="#EAF2E2" mode="Opaque"/>
                <graphicElement>
                    <pen lineWidth="0.75" lineColor="#B9D19B"/>
                </graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="345" y="10" width="120" height="20" forecolor="#33422F"/>
                <textElement verticalAlignment="Middle">
                    <font size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[Total do período]]></text>
            </staticText>
            <textField>
                <reportElement x="410" y="10" width="140" height="20" forecolor="#2F5C0E"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="13" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["R$ " + new java.text.DecimalFormat("#,##0.00").format($P{total})]]></textFieldExpression>
            </textField>
            <rectangle>
                <reportElement x="30" y="44" width="535" height="20" backcolor="#EFF3EB" mode="Opaque"/>
                <graphicElement>
                    <pen lineWidth="0.0"/>
                </graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="40" y="44" width="190" height="20" forecolor="#33422F"/>
                <textElement verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Quantidade por tipo de refeição:]]></text>
            </staticText>
            <textField>
                <reportElement x="230" y="44" width="325" height="20" forecolor="#33422F"/>
                <textElement verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{typeBreakdown}]]></textFieldExpression>
            </textField>
            <rectangle>
                <reportElement x="30" y="66" width="535" height="20" backcolor="#EFF3EB" mode="Opaque"/>
                <graphicElement>
                    <pen lineWidth="0.0"/>
                </graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="40" y="66" width="190" height="20" forecolor="#33422F"/>
                <textElement verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Quantidade por categoria:]]></text>
            </staticText>
            <textField>
                <reportElement x="230" y="66" width="325" height="20" forecolor="#33422F"/>
                <textElement verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{categoryBreakdown}]]></textFieldExpression>
            </textField>
        </band>
    </summary>

</jasperReport>
