<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="680.0" prefWidth="1150.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hospital.harmonia.controller.AgendaTelefonicaController">

    <top>
        <HBox alignment="CENTER_RIGHT" prefHeight="32.0" prefWidth="900.0" spacing="12.0" style="-fx-background-color: white;">
            <Button alignment="CENTER_RIGHT" onAction="#onBack" text="◀ Voltar">
                <font>
                    <Font name="Microsoft YaHei UI" size="12.0" />
                </font>
                <HBox.margin>
                    <Insets right="5.0" />
                </HBox.margin>
            </Button>
        </HBox>
    </top>

    <center>
        <TabPane style="-fx-background-color: white;" tabClosingPolicy="UNAVAILABLE">

            <!-- ==================== TAB 1: CONTATOS ==================== -->
            <Tab text="Contatos">
                <BorderPane style="-fx-background-color: white;">
                    <padding>
                        <Insets bottom="16" left="16" right="16" top="16" />
                    </padding>

                    <left>
                        <ScrollPane fitToWidth="true" prefHeight="600.0" prefWidth="360.0" style="-fx-background-color: transparent;" BorderPane.alignment="TOP_LEFT">
                            <VBox fillWidth="true" prefWidth="345.0" spacing="6.0">
                                <Label prefHeight="22.0" prefWidth="300.0" text="CONTATO">
                                    <font>
                                        <Font name="Microsoft YaHei UI Bold" size="16.0" />
                                    </font>
                                    <VBox.margin>
                                        <Insets bottom="6.0" top="5.0" />
                                    </VBox.margin>
                                </Label>

                                <Label text="Nome">
                                    <font>
                                        <Font name="Microsoft YaHei UI" size="13.0" />
                                    </font>
                                </Label>
                                <TextField fx:id="nameField" prefHeight="30.0" prefWidth="330.0" />

                                <Label text="Categoria">
                                    <font>
                                        <Font name="Microsoft YaHei UI" size="13.0" />
                                    </font>
                                    <VBox.margin>
                                        <Insets top="8.0" />
                                    </VBox.margin>
                                </Label>
                                <ComboBox fx:id="categoryCombo" maxWidth="Infinity" prefHeight="30.0" prefWidth="330.0" promptText="Selecione..." />

                                <HBox spacing="10.0">
                                    <VBox.margin>
                                        <Insets top="8.0" />
                                    </VBox.margin>
                                    <VBox prefWidth="160.0" spacing="4.0">
                                        <Label text="Telefone 1">
                                            <font>
                                                <Font name="Microsoft YaHei UI" size="13.0" />
                                            </font>
                                        </Label>
                                        <TextField fx:id="cellPhoneField" maxWidth="Infinity" prefHeight="30.0" />
                                    </VBox>
                                    <VBox prefWidth="160.0" spacing="4.0">
                                        <Label text="Telefone 2">
                                            <font>
                                                <Font name="Microsoft YaHei UI" size="13.0" />
                                            </font>
                                        </Label>
                                        <TextField fx:id="phoneField" maxWidth="Infinity" prefHeight="30.0" />
                                    </VBox>
                                </HBox>

                                <Label text="E-mail">
                                    <font>
                                        <Font name="Microsoft YaHei UI" size="13.0" />
                                    </font>
                                    <VBox.margin>
                                        <Insets top="8.0" />
                                    </VBox.margin>
                                </Label>
                                <TextField fx:id="emailField" prefHeight="30.0" prefWidth="330.0" />

                                <Label text="Observação">
                                    <font>
                                        <Font name="Microsoft YaHei UI" size="13.0" />
                                    </font>
                                    <VBox.margin>
                                        <Insets top="8.0" />
                                    </VBox.margin>
                                </Label>
                                <TextArea fx:id="noteArea" prefHeight="80.0" prefWidth="330.0" wrapText="true" />

                                <HBox alignment="CENTER_LEFT" spacing="6.0">
                                    <VBox.margin>
                                        <Insets top="14.0" />
                                    </VBox.margin>
                                    <Button fx:id="saveContactButton" onAction="#onSave" prefHeight="30.0" prefWidth="95.0" styleClass="secondary-button" stylesheets="@../css/styles.css" text="SALVAR" textFill="WHITE">
                                        <font>
                                            <Font name="Microsoft YaHei UI" size="12.0" />
                                        </font>
                                    </Button>
                                    <Button onAction="#onClearForm" prefHeight="30.0" prefWidth="95.0" styleClass="secondary-button" stylesheets="@../css/styles.css" text="LIMPAR" textFill="WHITE">
                                        <font>
                                            <Font name="Microsoft YaHei UI" size="12.0" />
                                        </font>
                                    </Button>
                                    <Button onAction="#onDeactivate" prefHeight="30.0" prefWidth="95.0" stylesheets="@../css/styles.css" text="INATIVAR" textFill="#c90000">
                                        <font>
                                            <Font name="Microsoft YaHei UI Bold" size="12.0" />
                                        </font>
                                    </Button>
                                    <Button onAction="#onActivate" prefHeight="30.0" prefWidth="95.0" stylesheets="@../css/styles.css" text="ATIVAR" textFill="#288d00">
                                        <font>
                                            <Font name="Microsoft YaHei UI Bold" size="12.0" />
                                        </font>
                                    </Button>
                                </HBox>
                            </VBox>
                        </ScrollPane>
                    </left>

                    <center>
                        <VBox spacing="4.0">
                            <BorderPane.margin>
                                <Insets left="16.0" />
                            </BorderPane.margin>
                            <Label style="-fx-text-fill: #777777; -fx-font-size: 11px;" text="Dica: dê duplo clique numa linha para editar." />
                            <HBox alignment="CENTER_LEFT" spacing="8.0">
                                <Label text="Pesquisar:" />
                                <TextField fx:id="searchField" prefWidth="220.0" promptText="Nome, categoria, telefone 1, telefone 2, e-mail..." />
                                <ComboBox fx:id="filterCategoryCombo" prefWidth="150.0" />
                                <ComboBox fx:id="filterActiveCombo" prefWidth="110.0" />
                            </HBox>
                            <TableView fx:id="contactTable" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="nameColumn" prefWidth="170.0" text="Nome" />
                                    <TableColumn fx:id="categoryColumn" prefWidth="140.0" text="Categoria" />
                                    <TableColumn fx:id="cellPhoneColumn" prefWidth="110.0" text="Telefone 1" />
                                    <TableColumn fx:id="phoneColumn" prefWidth="110.0" text="Telefone 2" />
                                    <TableColumn fx:id="emailColumn" prefWidth="150.0" text="E-mail" />
                                    <TableColumn fx:id="noteColumn" prefWidth="160.0" text="Observação" />
                                    <TableColumn fx:id="activeColumn" prefWidth="70.0" text="Ativo" />
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                </columnResizePolicy>
                            </TableView>
                        </VBox>
                    </center>
                </BorderPane>
            </Tab>

            <!-- ==================== TAB 2: CATEGORIAS ==================== -->
            <Tab text="Categorias">
                <BorderPane style="-fx-background-color: white;">
                    <padding>
                        <Insets bottom="16" left="16" right="16" top="16" />
                    </padding>

                    <left>
                        <VBox prefWidth="330.0" spacing="4.0">
                            <Label styleClass="subtitle" text="CADASTRAR CATEGORIA">
                                <font>
                                    <Font name="Microsoft YaHei UI Bold" size="16.0" />
                                </font>
                                <VBox.margin>
                                    <Insets bottom="10.0" />
                                </VBox.margin>
                            </Label>

                            <Label text="Nome da categoria">
                                <font>
                                    <Font name="Microsoft YaHei UI" size="13.0" />
                                </font>
                            </Label>
                            <TextField fx:id="categoryNameField" prefHeight="30.0" prefWidth="330.0" />

                            <Label text="O nome é gravado em maiúsculas. Duas categorias não podem ter o mesmo nome, mesmo escrito com outra caixa." wrapText="true">
                                <font>
                                    <Font name="Microsoft YaHei UI" size="11.0" />
                                </font>
                                <VBox.margin>
                                    <Insets top="6.0" />
                                </VBox.margin>
                            </Label>

                            <HBox spacing="8.0">
                                <VBox.margin>
                                    <Insets top="14.0" />
                                </VBox.margin>
                                <Button fx:id="saveCategoryButton" onAction="#onSaveCategory" styleClass="primary-button" stylesheets="@../css/styles.css" text="SALVAR">
                                    <font>
                                        <Font name="Microsoft YaHei UI" size="12.0" />
                                    </font>
                                </Button>
                                <Button onAction="#onClearCategoryForm" styleClass="secondary-button" stylesheets="@../css/styles.css" text="LIMPAR">
                                    <font>
                                        <Font name="Microsoft YaHei UI" size="12.0" />
                                    </font>
                                </Button>
                            </HBox>

                            <HBox spacing="8.0">
                                <VBox.margin>
                                    <Insets top="8.0" />
                                </VBox.margin>
                                <Button onAction="#onDeactivateCategory" styleClass="secondary-button" stylesheets="@../css/styles.css" text="INATIVAR">
                                    <font>
                                        <Font name="Microsoft YaHei UI" size="12.0" />
                                    </font>
                                </Button>
                                <Button onAction="#onActivateCategory" styleClass="secondary-button" stylesheets="@../css/styles.css" text="REATIVAR">
                                    <font>
                                        <Font name="Microsoft YaHei UI" size="12.0" />
                                    </font>
                                </Button>
                            </HBox>

                            <Label text="Dê duplo clique numa categoria da lista para renomeá-la. Inativar não apaga: quem já usa a categoria continua vinculado, ela só deixa de aparecer para novos cadastros." wrapText="true">
                                <font>
                                    <Font name="Microsoft YaHei UI" size="11.0" />
                                </font>
                                <VBox.margin>
                                    <Insets top="14.0" />
                                </VBox.margin>
                            </Label>
                        </VBox>
                    </left>

                    <center>
                        <VBox spacing="8.0">
                            <padding>
                                <Insets left="24.0" />
                            </padding>
                            <Label styleClass="subtitle" text="CATEGORIAS CADASTRADAS">
                                <font>
                                    <Font name="Microsoft YaHei UI Bold" size="16.0" />
                                </font>
                            </Label>
                            <TableView fx:id="categoryTable" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="categoryNameColumn" prefWidth="320.0" text="Categoria" />
                                    <TableColumn fx:id="categoryContactCountColumn" prefWidth="140.0" text="Contatos" />
                                    <TableColumn fx:id="categoryActiveColumn" prefWidth="100.0" text="Ativa" />
                                </columns>
                            </TableView>
                        </VBox>
                    </center>
                </BorderPane>
            </Tab>

        </TabPane>
    </center>
</BorderPane>
